{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cassn:schema:source-deployment:1",
  "title": "CASSN NDP source deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_type",
    "schema_version",
    "inventory_revision",
    "deployment",
    "content"
  ],
  "properties": {
    "manifest_type": {
      "const": "cassn.source.deployment"
    },
    "schema_version": {
      "const": 1
    },
    "inventory_revision": {
      "type": "integer",
      "minimum": 0
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "deployment_event_id",
        "organization",
        "site",
        "plot_number",
        "device_type",
        "coordinates",
        "deployment_interval"
      ],
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1
        },
        "deployment_event_id": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "const": "UC-Nature"
        },
        "site": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "plot_number": {
          "type": "integer",
          "minimum": 1
        },
        "device_type": {
          "enum": ["ML", "SA", "BD", "BT"]
        },
        "coordinates": {
          "description": "WGS84 plot coordinates from the authoritative plots.csv row.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["latitude", "longitude"],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "deployment_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "recording_interval", "inventory"],
      "properties": {
        "media_type": {
          "enum": ["image", "audio"]
        },
        "recording_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "end": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "file_counts", "total_bytes"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^metadata/file_metadata(?:-v[0-9]{2,})?\\.csv$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "file_counts": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "image": {
                  "type": "integer",
                  "minimum": 0
                },
                "audio": {
                  "type": "integer",
                  "minimum": 0
                },
                "config": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "total_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
