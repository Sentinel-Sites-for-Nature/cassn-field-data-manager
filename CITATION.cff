    affiliation: "University of California, Davis"
version: "4.0"
date-released: "2026-11-02"
license: MIT
repository-code: "https://github.com/Sentinel-Sites-for-Nature/cassn-field-data-manager"
keywords:
  - camera traps
  - passive acoustic monitoring
  - biodiversity monitoring
  - data management
  - metadata
