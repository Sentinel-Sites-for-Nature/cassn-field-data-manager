#!/bin/sh
# Launch Field Data Manager with this repository's tested Python environment.
set -eu

# Resolve this script's real location even when invoked through the
# ~/.local/bin/cassn-app symlink.
script_path=$0
while [ -L "$script_path" ]; do
    link_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
    link_target=$(readlink "$script_path")
    case "$link_target" in
        /*) script_path=$link_target ;;
        *) script_path=$link_dir/$link_target ;;
    esac
done

repo_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd)
venv_python=$repo_dir/.venv/bin/python

# Finder/Dock launches receive a minimal PATH. Include the normal Homebrew
# locations so ExifTool and FLAC are available just as they are in Terminal.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [ ! -x "$venv_python" ]; then
    printf '%s\n' \
        "Field Data Manager virtual environment was not found:" \
        "  $venv_python" \
        "Recreate .venv in $repo_dir before launching." >&2
    exit 1
fi

cd "$repo_dir"
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || printf '0')" = "1" ]; then
    exec /usr/bin/arch -arm64 "$venv_python" -m cassn "$@"
fi
exec "$venv_python" -m cassn "$@"
